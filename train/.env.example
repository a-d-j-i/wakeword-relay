# Config for run.sh — copy to `.env` and edit. The real `.env` is gitignored
# (it holds machine-local paths), so keep only placeholders in this example.
# A real environment variable overrides the value here.

# One working dir: dataset cache + per-phrase samples/features/teacher/models
# land under it. ~10GB downloaded on first run. Point at fast local scratch.
WORKDIR=/path/to/scratch

# Training tunables (run.sh's production defaults shown).
SAMPLES=5000
STEPS=45000
NEG_CLASS_WEIGHT=22

# DISTILL=0 plain training; DISTILL=1 knowledge distillation (adds a teacher
# phase and trains the deployed student with soft labels). See DISTILLATION.md.
DISTILL=0
# Distillation blend λ in [0,1] (only used when DISTILL=1):
# student target = (1-λ)·hard + λ·teacher.
DISTILL_WEIGHT=0.5
